[Unit]
Description=xFACE Biometric Access Control Service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Create the account first: sudo useradd --system --groups video --home /opt/xface xface
User=xface
Group=xface
SupplementaryGroups=video
WorkingDirectory=/opt/xface
EnvironmentFile=/opt/xface/.env
Environment=PYTHONUNBUFFERED=1
# One worker only: the camera and recognition worker live in-process
ExecStart=/opt/xface/.venv/bin/gunicorn --workers 1 --threads 32 --timeout 120 --bind 0.0.0.0:5000 run:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
