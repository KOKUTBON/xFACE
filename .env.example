# ==============================================================
# xFACE configuration. Copy to .env and adjust: cp .env.example .env
# Never commit your .env file.
# ==============================================================

# --- CompreFace face recognition engine ---
# Required only when starting the optional Compose production profile.
COMPREFACE_POSTGRES_PASSWORD=
HOST=http://localhost
PORT=8000
# Recognition service API key (CompreFace UI > your application > Recognition service)
API_KEY=
# Minimum face detection confidence (0.0 - 1.0)
DETECTION_PROBABILITY_THRESHOLD=0.80
# Minimum similarity to grant access (0.0 - 1.0). Raise it to reduce false accepts.
SIMILARITY_THRESHOLD=0.85
# Optional CompreFace plugins, e.g. age,gender (must be enabled in your CompreFace build)
FACE_PLUGINS=

# --- Door relay (Shelly) ---
# Leave empty to run without a relay (recognition and logging still work).
# Gen1 example (replace the hostname in private deployment configuration): http://<relay-host>/relay/0?turn=on&timer=2
# Gen2+ example (replace the hostname in private deployment configuration): http://<relay-host>/rpc/Switch.Set?id=0&on=true&toggle_after=2
SHELLY_URL=
SHELLY_TIMEOUT=3.0
# Seconds before the same person can open the door / be logged again
SHELLY_COOLDOWN_SECONDS=10.0
# Name of the controlled door, stored in every access log entry
DEVICE_NAME=Main Entrance

# --- Dashboard & security ---
# Required in production. If empty, xFACE creates DATA_DIR/.admin_password with mode 0600.
DASHBOARD_PASSWORD=
# Session signing key. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# If empty, a random key is generated at each start (users are logged out on restart).
SECRET_KEY=
# Require login to view the live monitor, video stream and live events
MONITOR_REQUIRE_LOGIN=true
# Comma-separated origins allowed to call the API from other sites (empty = same-origin only)
CORS_ORIGINS=

# Public-safe defaults. Set DEMO_MODE=false only after configuring real services and hardening deployment.
DEMO_MODE=true

# --- Camera ---
# Device index or private RTSP/HTTP URL (never commit a production URL or credential)
# or a path to a video file for testing.
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
# Seconds between recognition requests to CompreFace
RECOGNITION_INTERVAL=0.8

# --- Storage ---
# Directory for the SQLite database, access snapshots and temporary files
DATA_DIR=./data
# Optional: use another database, e.g. postgresql+psycopg://user:pass@localhost/xface
# DATABASE_URL=
# Delete access snapshots older than N days (0 = keep forever)
SNAPSHOT_RETENTION_DAYS=30

# --- Web server ---
WEB_HOST=0.0.0.0
WEB_PORT=5000
DEBUG=false
